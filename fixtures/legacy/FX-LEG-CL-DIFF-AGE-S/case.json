{
  "id": "FX-LEG-CL-DIFF-AGE-S",
  "kind": "client",
  "description": "A diff older than 30 s when the page asks for it is not sent; the page never got it, so the session gives a normal load and the final code is -1 (Standard)",
  "profile": "legacy-canonical",
  "mode": "standard",
  "server_profile": "legacy-canonical",
  "rules": [
    "CL-28",
    "CL-04"
  ],
  "rows": [
    "Q8",
    "S6"
  ],
  "divergences": [
    "D-36"
  ],
  "upstream": {
    "repo": "Tencent/VasSonic",
    "sha": "59936beff656d4b5718ff6444d6c5e001a2c5231"
  },
  "sources": [
    "docs:engineering/protocol/legacy-client#_9-rivqen-canonical-client-rules"
  ],
  "evidence": "code-reading",
  "config": {
    "account": "rq-test-account",
    "account_related": true,
    "reload_in_bad_network": false
  },
  "responses": {
    "r1": {
      "page": "b",
      "app": {
        "status": 200,
        "headers": [
          [
            "content-type",
            "text/html; charset=utf-8"
          ]
        ]
      }
    }
  },
  "cache_before": [
    {
      "page": "a"
    }
  ],
  "schedule": [
    {
      "case": "r1"
    },
    {
      "do": "hold",
      "point": "head"
    },
    {
      "do": "create_session"
    },
    {
      "do": "bind_client"
    },
    {
      "do": "client_ready"
    },
    {
      "do": "request_resource"
    },
    {
      "do": "wait",
      "for": "proxy.hold"
    },
    {
      "do": "settle",
      "ms": 300
    },
    {
      "do": "release"
    },
    {
      "do": "wait",
      "for": "proxy.response_end"
    },
    {
      "do": "settle",
      "ms": 31000
    },
    {
      "do": "get_diff"
    },
    {
      "do": "snapshot_cache"
    },
    {
      "do": "destroy"
    }
  ]
}
