{
  "id": "FX-LEG-CL-HEAD-RULES-Q",
  "kind": "client",
  "description": "The head test of DL-226: a 304 with Connection: content-security-policy on a visible entry is a normal load and the entry is removed, and a 200 with sonic-etag-key: Content-Security-Policy is a normal load (Quick)",
  "profile": "legacy-canonical",
  "mode": "quick",
  "server_profile": "legacy-canonical",
  "rules": [
    "CL-13",
    "CL-14",
    "CL-17",
    "CL-21"
  ],
  "rows": [],
  "divergences": [],
  "upstream": {
    "repo": "Tencent/VasSonic",
    "sha": "59936beff656d4b5718ff6444d6c5e001a2c5231"
  },
  "sources": [
    "docs:engineering/protocol/legacy-client#_9-3-response-classification"
  ],
  "evidence": "code-reading",
  "config": {
    "account": "rq-test-account",
    "account_related": true,
    "reload_in_bad_network": false
  },
  "responses": {
