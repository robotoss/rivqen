    },
    {
      "do": "client_ready"
    },
    {
      "do": "request_resource"
    },
    {
      "do": "wait",
      "for": "proxy.response_end"
    },
    {
      "do": "settle",
      "ms": 2500
    },
    {
      "do": "request_resource"
    },
    {
      "do": "get_diff"
    },
    {
      "do": "destroy"
    },
    {
      "do": "set_field",
      "name": "sonic-etag-key",
      "value": "Content-Security-Policy"
    },
    {
      "do": "create_session"
    },
    {
      "do": "bind_client"
    },
    {
      "do": "client_ready"
    },
    {
      "do": "request_resource"
    },
    {
      "do": "wait",
      "for": "proxy.response_end"
    },
    {
      "do": "settle",
      "ms": 2500
    },
    {
      "do": "request_resource"
    },
    {
      "do": "get_diff"
    },
    {
      "do": "snapshot_cache"
    },
    {
      "do": "destroy"
    }
  ]
