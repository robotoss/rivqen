{
  "id": "FX-LEG-CL-NO-STORE-304-Q",
  "kind": "client",
  "description": "A 304 with Cache-Control no-store after the cached page was delivered: the entry is removed, the page stays, codes 304 / 304 (Quick)",
  "profile": "legacy-canonical",
  "mode": "quick",
  "server_profile": "legacy-canonical",
  "rules": [
    "CL-17",
    "CL-39",
    "CL-15"
  ],
  "rows": [
    "Q7",
    "S5"
  ],
  "divergences": [
    "D-41",
    "D-45"
  ],
  "upstream": {
    "repo": "Tencent/VasSonic",
    "sha": "59936beff656d4b5718ff6444d6c5e001a2c5231"
  },
  "sources": [
    "docs:engineering/protocol/legacy-client#_9-3-response-classification"
  ],
  "evidence": "code-reading",
  "config": {
    "account": "rq-test-account",
    "account_related": true,
    "reload_in_bad_network": false
  },
  "responses": {
    "r1": {
      "page": "a",
      "app": {
        "status": 200,
        "headers": [
          [
            "content-type",
            "text/html; charset=utf-8"
          ]
        ]
      }
    }
  },
  "cache_before": [
    {
      "page": "a"
    }
  ],
  "schedule": [
    {
      "case": "r1"
    },
    {
      "do": "set_field",
      "name": "cache-control",
      "value": "no-store"
    },
    {
      "do": "hold",
      "point": "head"
    },
    {
      "do": "create_session"
    },
    {
      "do": "bind_client"
    },
    {
      "do": "client_ready"
    },
    {
      "do": "request_resource"
    },
    {
      "do": "wait",
      "for": "proxy.hold"
    },
    {
      "do": "settle",
      "ms": 300
    },
    {
      "do": "release"
    },
    {
      "do": "wait",
      "for": "proxy.response_end"
    },
    {
      "do": "settle",
      "ms": 2500
    },
    {
      "do": "request_resource"
    },
    {
      "do": "get_diff"
    },
    {
      "do": "snapshot_cache"
    },
    {
      "do": "destroy"
    }
  ]
}
