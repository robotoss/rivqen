{
  "id": "FX-RQ-MARKUP-CONTENT-FOREIGN-IMAGE",
  "description": "An svg image element in the content: outside FOREIGN_ALLOWED, valid markup since H-78 (FOREIGN_ALLOWED is a patch content rule; M-07 holds)",
  "rules": [
    "M-07",
    "M-22",
    "M-23"
  ],
  "expect": {
    "valid": true,
    "blocks": [
