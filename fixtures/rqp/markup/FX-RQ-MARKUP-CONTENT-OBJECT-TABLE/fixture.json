{
  "id": "FX-RQ-MARKUP-CONTENT-OBJECT-TABLE",
  "description": "A table in an object in the content (H-78: object in a block; M-09 and M-23 hold)",
  "rules": [
    "M-09",
    "M-22",
    "M-23"
  ],
  "expect": {
    "valid": true,
    "blocks": [
      {
        "id": "box",
