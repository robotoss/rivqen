{
  "id": "FX-RQ-MARKUP-CONTENT-SCRIPT-ESCAPED",
  "description": "A script in the content with <!--<script>: the first </script> ends the double-escaped state, not the script (H-78, M-04)",
  "rules": [
    "M-04",
    "M-23"
  ],
  "expect": {
    "valid": true,
    "blocks": [
      {
        "id": "box",
        "format": "html",
        "start_tag": "<div data-rq-block=\"box\">",
        "content": "<script>a<!--<script>b</script>c--></script>x"
      }
    ]
  }
}
