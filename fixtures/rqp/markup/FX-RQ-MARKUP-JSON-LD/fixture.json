{
  "id": "FX-RQ-MARKUP-JSON-LD",
  "description": "A JSON-LD block in the head and a json block in the body: both have the format json (H-86)",
  "rules": [
    "M-16",
    "M-25"
  ],
  "expect": {
    "valid": true,
    "blocks": [
      {
        "id": "ld",
        "format": "json",
        "start_tag": "<script type=\"application/ld+json\" data-rq-block=\"ld\">",
        "content": "{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Shop\",\"offers\":{\"@type\":\"Offer\",\"price\":\"120.00\"}}"
      },
      {
        "id": "cart",
        "format": "json",
        "start_tag": "<script type=\"application/json\" data-rq-block=\"cart\">",
        "content": "{\"items\":3}"
      }
    ]
  }
}
