{
  "id": "FX-RQ-C01-BASE-MISMATCH",
  "kind": "client",
  "description": "A delta with base_revision r1(page-b), not r1(page-a)",
  "rules": ["RQP-13"],
  "context": {
    "navigation": "delta",
    "snapshot": "page-a"
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "application/vnd.rivqen.delta+json"],
      ["rq-version", "1"],
      ["cache-control", "no-store"]
    ],
    "body": {
      "delta": {
        "from": "page-a",
        "to": "page-b",
        "base_revision": "page-b"
      }
    }
  }
}
