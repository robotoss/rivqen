{
  "id": "FX-RQ-C14-HTTP-DEBUG-FLAG",
  "kind": "client",
  "description": "An http URL in a debug build with the app flag: RQP (H-49)",
  "rules": ["RQP-22"],
  "context": {
    "url": "http://shop.example.com/catalog",
    "build": "debug",
    "allow_http": true,
    "navigation": "first-visit",
    "snapshot": null
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["rq-version", "1"],
      ["etag", "{{r1:page-a}}"],
      ["cache-control", "no-cache"]
    ],
    "body": {
      "full": "page-a"
    }
  }
}
