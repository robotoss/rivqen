  "rules": ["RQP-13"],
  "context": {
    "navigation": "delta",
    "snapshot": {
      "page": "page-a",
      "members": {
        "policy": {
          "ttl_seconds": 60
        }
      }
    }
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "application/vnd.rivqen.delta+json"],
      ["rq-version", "1"],
      ["cache-control", "no-store"]
    ],
    "body": {
      "delta": {
        "from": "page-a",
        "to": "page-b"
      }
    }
  }
}
