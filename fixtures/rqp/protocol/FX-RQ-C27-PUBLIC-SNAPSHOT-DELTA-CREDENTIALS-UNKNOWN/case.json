{
  "id": "FX-RQ-C27-PUBLIC-SNAPSHOT-DELTA-CREDENTIALS-UNKNOWN",
  "kind": "client",
  "description": "A snapshot in the public partition and a valid delta, but the client does not know whether the request had credentials: the delta is applied and the result goes to the partition of the request; the public snapshot does not change (H-65)",
  "rules": ["RQP-25"],
  "context": {
    "public_origin": true,
    "navigation": "delta",
    "snapshot": {
      "page": "page-a",
      "members": {
        "policy": {
          "mode": "public"
        }
      },
      "partition": "public"
    },
    "credentials": null
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "application/vnd.rivqen.delta+json"],
      ["rq-version", "1"],
      ["cache-control", "no-store"]
    ],
    "body": {
      "delta": {
        "from": "page-a",
        "to": "page-b"
      }
    }
  }
}
