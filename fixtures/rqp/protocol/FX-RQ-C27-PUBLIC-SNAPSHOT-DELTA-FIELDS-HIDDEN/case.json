{
  "id": "FX-RQ-C27-PUBLIC-SNAPSHOT-DELTA-FIELDS-HIDDEN",
  "kind": "client",
  "description": "A snapshot in the public partition, a request without credentials and a valid delta, but the native SDK did not see all header fields of the delta response: the result goes to the partition of the request (H-64, H-65; DL-040 I-2)",
  "rules": ["RQP-25"],
  "context": {
    "public_origin": true,
    "navigation": "delta",
    "snapshot": {
      "page": "page-a",
      "members": {
        "policy": {
          "mode": "public"
        }
      },
      "partition": "public"
    },
    "credentials": false,
    "response_fields_visible": false
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "application/vnd.rivqen.delta+json"],
      ["rq-version", "1"],
      ["cache-control", "no-store"]
    ],
    "body": {
      "delta": {
        "from": "page-a",
        "to": "page-b"
      }
    }
  }
}
