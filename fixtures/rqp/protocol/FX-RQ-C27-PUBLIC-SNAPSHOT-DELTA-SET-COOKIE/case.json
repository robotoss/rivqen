{
  "id": "FX-RQ-C27-PUBLIC-SNAPSHOT-DELTA-SET-COOKIE",
  "kind": "client",
  "description": "A snapshot in the public partition, a request without credentials and a valid delta with a Set-Cookie field: the result goes to the partition of the request (H-65, H-63)",
  "rules": ["RQP-25"],
  "context": {
    "public_origin": true,
    "navigation": "delta",
    "snapshot": {
      "page": "page-a",
      "members": {
        "policy": {
          "mode": "public"
        }
      },
      "partition": "public"
    },
    "credentials": false
  },
  "response": {
    "status": 200,
    "headers": [
      ["content-type", "application/vnd.rivqen.delta+json"],
      ["rq-version", "1"],
      ["cache-control", "no-store"],
      ["set-cookie", "session=1; Secure; HttpOnly"]
    ],
    "body": {
      "delta": {
        "from": "page-a",
        "to": "page-b"
      }
    }
  }
}
