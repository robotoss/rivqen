{
  "id": "FX-RQ-P01-APP-ETAG",
  "description": "First visit; the application has its own ETag and Last-Modified: the ETag of F replaces the ETag of the application, and F has no Last-Modified (DL-032; extra case)",
  "rules": ["RQP-08", "RQP-16"],
  "page": "page-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"],
      ["etag", "\"app-1\""],
      ["last-modified", "Mon, 12 Oct 2026 08:00:00 GMT"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html"]
    ]
  }
}
