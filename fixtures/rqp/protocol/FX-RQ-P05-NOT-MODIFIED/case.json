{
  "id": "FX-RQ-P05-NOT-MODIFIED",
  "description": "The client has the current page: 304 with the ETag and Cache-Control of F, no body",
  "rules": ["RQP-03"],
  "page": "page-a",
  "client_page": "page-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-a}}"],
      ["rq-have", "t={{t1:page-a}}, b={{have:page-a}}, n=:AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
