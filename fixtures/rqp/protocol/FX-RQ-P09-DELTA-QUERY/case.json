{
  "id": "FX-RQ-P09-DELTA-QUERY",
  "description": "Delta with only the changed block for a target URL with a query: U of the binding is the target URL with its query (H-107); the manifest path has no query (manifest-patch section 1.6)",
  "rules": ["RQP-01", "RQP-08", "RQP-11"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "target": "https://shop.example.com/catalog?sort=price&page=2",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}, n=:AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
