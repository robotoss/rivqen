{
  "id": "FX-RQ-P16-HAVE-4096",
  "description": "Rq-Have of exactly 4096 bytes is parsed: delta (boundary, extra case)",
  "rules": ["RQP-12"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}, x=\"\""]
    ]
  }
}
