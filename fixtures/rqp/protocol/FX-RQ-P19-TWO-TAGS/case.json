{
  "id": "FX-RQ-P19-TWO-TAGS",
  "description": "If-None-Match with two tags: no base, F",
  "rules": ["RQP-10"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}, {{r1:page-t2}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}"]
    ]
  }
}
