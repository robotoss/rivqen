{
  "id": "FX-RQ-P24-RANGE",
  "description": "A Range request is not delta-eligible: F with status 200",
  "rules": ["RQP-10"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"],
      ["range", "bytes=0-99"]
    ]
  }
}
