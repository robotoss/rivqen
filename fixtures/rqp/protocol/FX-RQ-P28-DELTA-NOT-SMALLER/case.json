{
  "id": "FX-RQ-P28-DELTA-NOT-SMALLER",
  "description": "The delta is not smaller than F (JSON escapes): F",
  "rules": ["RQP-11"],
  "page": "page-esc-b",
  "client_page": "page-esc-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-esc-a}}"],
      ["rq-have", "t={{t1:page-esc-a}}, b={{have:page-esc-a}}"]
    ]
  }
}
