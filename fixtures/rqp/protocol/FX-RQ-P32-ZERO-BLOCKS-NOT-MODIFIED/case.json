{
  "id": "FX-RQ-P32-ZERO-BLOCKS-NOT-MODIFIED",
  "description": "R(page-zero) with b=:: on the same page: 304",
  "rules": ["RQP-03"],
  "page": "page-zero",
  "client_page": "page-zero",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-zero}}"],
      ["rq-have", "t={{t1:page-zero}}, b={{have:page-zero}}"]
    ]
  }
}
