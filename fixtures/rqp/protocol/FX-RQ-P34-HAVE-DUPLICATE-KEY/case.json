{
  "id": "FX-RQ-P34-HAVE-DUPLICATE-KEY",
  "description": "Rq-Have with t two times: the last value wins, delta as P-09",
  "rules": ["RQP-11"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-t2}}, b={{have:page-big-a}}, t={{t1:page-big-a}}"]
    ]
  }
}
