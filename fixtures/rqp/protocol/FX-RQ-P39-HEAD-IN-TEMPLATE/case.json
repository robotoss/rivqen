{
  "id": "FX-RQ-P39-HEAD-IN-TEMPLATE",
  "description": "The only </head> closes a head start tag inside a template in the body: no head end tag, the page is sent without RQP (DL-031)",
  "rules": ["RQP-09"],
  "page": "page-head-template",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html"]
    ]
  }
}
