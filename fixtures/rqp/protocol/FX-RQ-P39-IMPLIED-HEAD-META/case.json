{
  "id": "FX-RQ-P39-IMPLIED-HEAD-META",
  "description": "No <head> start tag; a meta start tag comes first: the head is implied, F has the manifest immediately before <meta> (H-79a)",
  "rules": ["RQP-20"],
  "page": "page-implied-meta",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html"]
    ]
  }
}
