{
  "id": "FX-RQ-P43-APP-VARY-DELTA",
  "description": "The application sends Vary: Accept-Encoding, Rq-Nonce; D lists Accept-Encoding (MUST) and Rq-Nonce (SHOULD), no other Rq-* member, and has X-Content-Type-Options: nosniff (RQP-01, DL-063)",
  "rules": ["RQP-01"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"],
      ["vary", "Accept-Encoding, Rq-Nonce"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
