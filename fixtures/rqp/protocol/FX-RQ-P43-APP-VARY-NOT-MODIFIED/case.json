{
  "id": "FX-RQ-P43-APP-VARY-NOT-MODIFIED",
  "description": "The application sends Vary: Accept-Encoding, Rq-Nonce; the 304 has the Vary of F: Accept-Encoding, no Rq-* member (RQP-03, RQP-08, DL-063)",
  "rules": ["RQP-03", "RQP-08"],
  "page": "page-a",
  "client_page": "page-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"],
      ["vary", "Accept-Encoding, Rq-Nonce"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-a}}"],
      ["rq-have", "t={{t1:page-a}}, b={{have:page-a}}"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
