{
  "id": "FX-RQ-P46-INM-TRAILING-COMMA-NO-BASE",
  "description": "A delta request whose If-None-Match is one tag and an empty list element gives no delta base: F, never D (open input 10)",
  "rules": ["RQP-10"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}},"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
