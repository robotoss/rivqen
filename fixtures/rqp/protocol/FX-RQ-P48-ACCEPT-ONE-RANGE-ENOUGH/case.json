{
  "id": "FX-RQ-P48-ACCEPT-ONE-RANGE-ENOUGH",
  "description": "One media range that accepts the delta type is enough, also when another range of the same type has q=0: D (open input 9)",
  "rules": ["RQP-10"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json;q=0, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b={{have:page-big-a}}"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
