{
  "id": "FX-RQ-P50-PATH-OVER-LIMIT",
  "description": "A request path of 4097 characters is over the manifest limit: A without its Rq-* fields, no manifest (open input 6)",
  "rules": ["RQP-09"],
  "page": "page-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "target": "https://shop.example.",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html"]
    ]
  }
}
