{
  "id": "FX-RQ-P51-HAVE-B-BAD-PADDING",
  "description": "An Rq-Have whose b has an incomplete padding fails the Dictionary parse, so Rq-Have is absent: F, not a delta (open inputs 7 and 12)",
  "rules": ["RQP-06"],
  "page": "page-big-b",
  "client_page": "page-big-a",
  "app": {
    "status": 200,
    "headers": [
      ["content-type", "text/html; charset=utf-8"],
      ["cache-control", "no-cache"]
    ]
  },
  "request": {
    "method": "GET",
    "headers": [
      ["rq-version", "1"],
      ["rq-capabilities", "(block-patch)"],
      ["accept", "text/html, application/vnd.rivqen.delta+json"],
      ["if-none-match", "{{r1:page-big-a}}"],
      ["rq-have", "t={{t1:page-big-a}}, b=:AAAAAAAAAA=:"],
      ["rq-nonce", ":AAECAwQFBgcICQoLDA0ODw==:"]
    ]
  }
}
