{
  "description": "Draft revisions such as rev-042 are not rqp/1 revisions (H-8)",
  "expect": {
    "keyword": "pattern",
    "instancePath": "/page_revision"
  },
  "instance": {
    "protocol": "rqp/1",
    "origin": "https://shop.example.com",
    "path": "/catalog",
    "page_revision": "rev-042",
    "policy": {
      "ttl_seconds": 60
    },
    "limits": {
      "max_patch_bytes": 65536
    }
  }
}
