{
  "name": "rqp-markup-node",
  "version": "0.0.0",
  "private": true,
  "description": "RQP markup parser candidate (Node.js): markup.md rqp/1 rules on a byte-level tokenizer",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rqp-markup": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:mutation": "RQP_FUZZ_ITERATIONS=400 RQP_TREE_ITERATIONS=300 RQP_PROP_ITERATIONS=300 node --test --test-skip-pattern=\"\\[perf\\]\" \"test/*.test.mjs\"",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "parse5": "8.0.1"
  }
}
