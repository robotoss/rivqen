<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee">
  <!-- ControlFilter first: it answers the control paths and keeps them away from the upstream filter. -->
  <filter><filter-name>ControlFilter</filter-name><filter-class>ControlFilter</filter-class></filter>
  <filter><filter-name>SonicFilter</filter-name><filter-class>com.github.tencent.SonicFilter</filter-class></filter>
  <filter-mapping><filter-name>ControlFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>SonicFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <servlet><servlet-name>page</servlet-name><servlet-class>PageServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>page</servlet-name><url-pattern>/p/*</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>page</servlet-name><url-pattern>/</url-pattern></servlet-mapping>
</web-app>
